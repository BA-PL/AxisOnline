    <Method Name="M_States" Id="{cd8183ec-6402-4ebd-983a-e3cf7e5b673a}">
      <Declaration><![CDATA[METHOD M_States : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Read States and forward main states
AxisRef.ReadStatus();
Axis.stStatus.stAxisStatus		:= AxisRef.Status;
Axis.stStatus.dwAxisId			:= AxisRef.NcToPlc.AxisId;
Axis.stStatus.bNcError			:= AxisRef.Status.Error;
Axis.stStatus.udiNcErrorCode		:= AxisRef.Status.ErrorID;
Axis.stStatus.udiNcErrorCodeHex	:= AxisRef.Status.ErrorID;

Axis.stStatus.sAxisName			:= Axis.stAxisParameter.sAxisName;
Axis.stStatus.lrActPos			:= AxisRef.NcToPlc.ActPos;
Axis.stStatus.lrModuloActPos		:= AxisRef.NcToPlc.ModuloActPos;
Axis.stStatus.lrActVelo			:= AxisRef.NcToPlc.ActVelo;
Axis.stStatus.lrActAcc			:= AxisRef.NcToPlc.ActAcc;
Axis.stStatus.lrActTorque			:= AxisRef.NcToPlc.ActTorque;
Axis.stStatus.lrPosDiff			:= AxisRef.NcToPlc.PosDiff;
Axis.stStatus.lrPosDiff_Max		:= MAX(AxisRef.NcToPlc.PosDiff, Axis.stStatus.lrPosDiff_Max);
Axis.stStatus.lrPosDiff_Min		:= MIN(AxisRef.NcToPlc.PosDiff, Axis.stStatus.lrPosDiff_Min);
Axis.stStatus.lrSetPos			:= AxisRef.NcToPlc.SetPos;
Axis.stStatus.lrSetVelo			:= AxisRef.NcToPlc.SetVelo;
Axis.stStatus.lrSetAcc			:= AxisRef.NcToPlc.SetAcc;
Axis.stStatus.lrSetTorque			:= AxisRef.NcToPlc.SetTorque;
Axis.stStatus.bAxisReady			:= AxisRef.Status.Operational;
Axis.stStatus.bHomed				:= AxisRef.Status.Homed;
Axis.stStatus.bCoupled			:= AxisRef.Status.Coupled;

// zezwolenie na zjazd z krancowki hw
AxisRef.PlcToNc.ControlDWord.8				:= Axis.stStatus.bAcceptBlockedDrive;

fbReadCycle(IN := NOT fbReadCycle.Q, PT := T#500MS);
fbReadTotalOutput(
	NETID:= , 
	PORT:= 501 , 
	IDXGRP:= 16#7100 + AxisRef.NcToPlc.AxisId , 
	IDXOFFS:= 16#3 , 
	LEN:= SIZEOF(lrTotalOutput) , 
	DESTADDR:= ADR(lrTotalOutput), 
	READ:=fbReadCycle.Q );

Axis.stStatus.lrTotalOutputInPercent := lrTotalOutput * 100.0;

fbReadControllerOutput(
	NETID:= , 
	PORT:= 501 , 
	IDXGRP:= 16#6100 + AxisRef.NcToPlc.AxisId , 
	IDXOFFS:= 16#3 , 
	LEN:= SIZEOF(lrControllerOutput) , 
	DESTADDR:= ADR(lrControllerOutput), 
	READ:=fbReadCycle.Q );

Axis.stStatus.lrControllerOutputInPercent := lrControllerOutput * 100.0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Stop" Id="{c6b94d00-7195-4070-bcb3-0a9209680881}">
      <Declaration><![CDATA[METHOD M_Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mcHalt(		Axis						:= AxisRef,
			Execute						:= Axis.mcHalt.bExecute,
			Deceleration				:= Axis.mcHalt.lrDeceleration,
			Jerk						:= Axis.mcHalt.lrJerk,
			BufferMode					:= Axis.mcHalt.eBufferMode,
			Options						:= Axis.mcHalt.stOptions,
			Done						=> Axis.mcHalt.bDone,
			Busy						=> Axis.mcHalt.bBusy,
			Active						=> Axis.mcHalt.bActive,
			CommandAborted				=> Axis.mcHalt.bCommandAborted,
			Error						=> Axis.mcHalt.bError,
			ErrorID						=> Axis.mcHalt.udiErrorID);
			
mcStop(		Axis						:= AxisRef,
			Execute						:= Axis.mcStop.bExecute,
			Deceleration				:= Axis.mcStop.lrDeceleration,
			Jerk						:= Axis.mcStop.lrJerk,
			Options						:= Axis.mcStop.stOptions,
			Done						=> Axis.mcStop.bDone,
			Busy						=> Axis.mcStop.bBusy,
			Active						=> Axis.mcStop.bActive,
			CommandAborted				=> Axis.mcStop.bCommandAborted,
			Error						=> Axis.mcStop.bError,
			ErrorID						=> Axis.mcStop.udiErrorID);
			
mcStopSS2(	Axis						:= AxisRef,
			Execute						:= Axis.mcSS2.bExecute,
			Deceleration				:= Axis.mcSS2.lrDeceleration,
			Jerk						:= Axis.mcSS2.lrJerk,
			Options						:= Axis.mcSS2.stOptions,
			Done						=> Axis.mcSS2.bDone,
			Busy						=> Axis.mcSS2.bBusy,
			Active						=> Axis.mcSS2.bActive,
			CommandAborted				=> Axis.mcSS2.bCommandAborted,
			Error						=> Axis.mcSS2.bError,
			ErrorID						=> Axis.mcSS2.udiErrorID);
			
mcStopSS1(	Axis						:= AxisRef,
			Execute						:= Axis.mcSS1.bExecute,
			Deceleration				:= Axis.mcSS1.lrDeceleration,
			Jerk						:= Axis.mcSS1.lrJerk,
			Options						:= Axis.mcSS1.stOptions,
			Done						=> Axis.mcSS1.bDone,
			Busy						=> Axis.mcSS1.bBusy,
			Active						=> Axis.mcSS1.bActive,
			CommandAborted				=> Axis.mcSS1.bCommandAborted,
			Error						=> Axis.mcSS1.bError,
			ErrorID						=> Axis.mcSS1.udiErrorID);
// SS1 - after MC_Stop function we have to disable drive			
Axis.mcPower.bEnable R= Axis.mcPower.bEnable_Positive R= Axis.mcPower.bEnable_Negative R= (Axis.mcSS1.bDone OR Axis.mcSS1.bCommandAborted OR Axis.mcSS1.bError);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SWLimitSwitch" Id="{fdca5ce9-9784-4207-a171-5f2b9564f280}">
      <Declaration><![CDATA[METHOD M_SWLimitSwitch : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbNcLimitSwitch(	udiAxisID		:= AxisRef.NcToPlc.AxisId, 
					bRead			:= Axis.stNcLimitSwitch.bRead, 
					bWrite			:= Axis.stNcLimitSwitch.bWrite, 
					bReset			:= Axis.stNcLimitSwitch.bReset, 
					lrSetMinPos		:= Axis.stNcLimitSwitch.lrSetMinPos, 
					lrSetMaxPos		:= Axis.stNcLimitSwitch.lrSetMaxPos, 
					bSetMinMon		:= Axis.stNcLimitSwitch.bSetMinMon, 
					bSetMaxMon		:= Axis.stNcLimitSwitch.bSetMaxMon, 
					bBusy			=> Axis.stNcLimitSwitch.bBusy, 
					bError			=> Axis.stNcLimitSwitch.bError, 
					udiErrorID		=> Axis.stNcLimitSwitch.udiErrorID, 
					lrActMinPos		=> Axis.stNcLimitSwitch.lrActMinPos, 
					lrActMaxPos		=> Axis.stNcLimitSwitch.lrActMaxPos, 
					bActMinMon		=> Axis.stNcLimitSwitch.bActMinMon, 
					bActMaxMon		=> Axis.stNcLimitSwitch.bActMaxMon);]]></ST>
      </Implementation>
    </Method>

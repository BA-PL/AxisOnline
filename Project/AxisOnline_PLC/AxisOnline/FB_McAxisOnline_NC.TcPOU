    <Method Name="M_SetPosition" Id="{ee5a91ad-7149-4842-b4ea-5156be2b1c73}">
      <Declaration><![CDATA[METHOD M_SetPosition : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mcSetPosition(		Axis				:= AxisRef,
					Execute				:= Axis.mcSetPosition.bExecute,
					Position			:= Axis.mcSetPosition.lrPosition,

//// Halt
//GVL.arrStAxisOnline[1].mcHalt.bExecute				:= bHalt;
//GVL.arrStAxisOnline[2].mcHalt.bExecute				:= bHalt;
//GVL.arrStAxisOnline[3].mcHalt.bExecute				:= bHalt;

//// Reset
//GVL.arrStAxisOnline[1].mcReset.bExecute				:= bReset AND GVL.arrStAxisOnline[1].bError;
//GVL.arrStAxisOnline[2].mcReset.bExecute				:= bReset AND GVL.arrStAxisOnline[2].bError;
//GVL.arrStAxisOnline[3].mcReset.bExecute				:= bReset AND GVL.arrStAxisOnline[3].bError;


//// any Error?
//GVL.arrStAxisOnline[1].bError;


